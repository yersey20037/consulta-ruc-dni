# Configuracion del servicio de consulta RUC/DNI.
# Copia este archivo como .env y ajusta lo que necesites.
# Tras cambiar algo:  pm2 restart consulta-ruc-dni

# Puerto de escucha
PORT=8080

# Hora de la actualizacion diaria del padron (formato 24h, HH:MM).
# Dejalo vacio para desactivar la actualizacion automatica.
HORA_ACTUALIZACION=03:00

# Token de acceso. Vacio = sin token (red local).
API_TOKEN=

# '1' quita tambien tildes y la N del texto de salida.
SOLO_ASCII=0

# Donde vive la base. Descomenta si la quieres en otro disco.
# PADRON_DIR=D:/datos-padron

# URL del padron, por si SUNAT cambia la ruta.
# PADRON_URL=http://www2.sunat.gob.pe/padron_reducido_ruc.zip
